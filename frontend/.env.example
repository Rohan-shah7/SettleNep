# Public, browser-exposed configuration.
# Never put secrets or private keys in NEXT_PUBLIC_* variables.

# Solana cluster: devnet | testnet | localnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# RPC endpoint for the selected cluster. Uses the public Devnet endpoint by default.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployed SettleNep program ID (placeholder until the Phase 7 deployment).
NEXT_PUBLIC_SETTLENEP_PROGRAM_ID=GFqpc53KGyUi1BGraoZxVCczM6iUCkRQdB8HfnBiH9RZ
